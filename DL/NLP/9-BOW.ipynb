   "source": [
    "from sklearn.feature_extraction.text import CountVectorizer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2460c01f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['deep' 'learning' 'love' 'nlp']\n",
      "[[0 0 1 1]\n",
      " [1 1 1 0]]\n"
     ]
    }
   ],
   "source": [
    "docs = [\"I love NLP\", \"I love Deep Learning\"]\n",
    "vec = CountVectorizer()\n",
    "X = vec.fit_transform(docs)\n",
    "##to see the vocabulary\n",
    "print(vec.get_feature_names_out())\n",
    "##to see the matrix\n",
    "print(X.toarray())\n",
    "##love nlp "
   ]
  },
